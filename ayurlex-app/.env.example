# Option 1: any OpenAI-compatible provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Option 2: Vercel AI Gateway. Vercel deployments may use VERCEL_OIDC_TOKEN
# automatically, so a long-lived key is not required when Gateway is enabled.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-4o-mini
